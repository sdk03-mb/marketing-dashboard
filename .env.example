# Mapbox public token (pk.…) for the satellite country maps in the report. Copy to .env.local and fill in.
# Without it the report draws the vector map instead.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: a Mapbox Studio style (user/styleid) with a fill layer on the "Mapbox Countries v1" tileset.
# With it, Mapbox colours the country itself (setfilter on that layer) and labels print on top.
NEXT_PUBLIC_MAPBOX_STYLE=
# Layer id of that fill layer in the style (default country-fill).
NEXT_PUBLIC_MAPBOX_LAYER=country-fill
